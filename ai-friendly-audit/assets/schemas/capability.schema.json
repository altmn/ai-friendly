{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-friendly-audit.invalid/schemas/capability.schema.json",
  "title": "AI Friendly Audit \u2014 capability",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/id"
    },
    "captured_at": {
      "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/timestamp"
    },
    "conversation_surface": {
      "type": "string",
      "minLength": 1
    },
    "execution_location": {
      "enum": [
        "local",
        "cloud",
        "unknown"
      ]
    },
    "browser_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "available",
              "denied",
              "unsupported",
              "failed",
              "not_attempted"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "captured_at",
    "conversation_surface",
    "execution_location",
    "browser_context",
    "capabilities"
  ],
  "additionalProperties": false
}
