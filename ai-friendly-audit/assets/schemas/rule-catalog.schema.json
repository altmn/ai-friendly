{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-friendly-audit.invalid/schemas/rule-catalog.schema.json",
  "title": "AI Friendly Audit \u2014 rule-catalog",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/version"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AFF-[A-Z]+-[0-9]{3}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "pattern": "^AFF-[A-Z]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/profile"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "guide_goal": {
            "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/guide_goal"
          },
          "guide_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "guide_checklist_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "basis": {
            "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/basis"
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_scope": {
            "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/scope"
          },
          "procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "false_positives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "owner_verification_ids": {
            "type": "array",
            "items": {
              "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/source"
            },
            "minItems": 1
          },
          "evidence_variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required_capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "required_capabilities",
                "scope"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "version",
          "group",
          "title",
          "profiles",
          "guide_goal",
          "guide_sections",
          "guide_checklist_ids",
          "basis",
          "applicability",
          "required_capabilities",
          "evidence_scope",
          "procedure",
          "expected_result",
          "required_evidence",
          "limitations",
          "false_positives",
          "remedy",
          "acceptance_procedure",
          "owner_verification_ids",
          "sources"
        ],
        "additionalProperties": true
      },
      "minItems": 20
    },
    "owner_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OWN-[A-Z]+-[0-9]{3}$"
          },
          "evidence_scope": {
            "const": "owner_verification_required"
          },
          "guide_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "guide_checklist_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "unknown_guarantee": {
            "type": "string",
            "minLength": 1
          },
          "workstream": {
            "type": "string",
            "minLength": 1
          },
          "requested_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance_procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "evidence_scope",
          "guide_sections",
          "guide_checklist_ids",
          "unknown_guarantee",
          "workstream",
          "requested_evidence",
          "acceptance_procedure",
          "review_trigger"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "guide_crosswalk": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checklist_id": {
            "type": "string",
            "pattern": "^G-A(0[1-9]|1[0-9]|2[0-6])$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "guide_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_verification_ids": {
            "type": "array",
            "items": {
              "$ref": "https://ai-friendly-audit.invalid/schemas/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "checklist_id",
          "subject",
          "guide_sections",
          "rule_ids",
          "owner_verification_ids"
        ],
        "additionalProperties": true
      },
      "minItems": 26,
      "maxItems": 26
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "rules",
    "owner_requirements",
    "guide_crosswalk"
  ],
  "additionalProperties": true
}
